    "cli",
    "zero-dependencies",
    "nodejs",
    "typescript",
    "devops",
    "ci-cd"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "secure-keystore": "./bin/cli.js"
  },
  "files": [
    "src/",
    "bin/",
