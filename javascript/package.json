      "url": "https://tech-style.co/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eharain/secure-keystore.git",
    "directory": "javascript"
  },
  "bugs": {
    "url": "https://github.com/eharain/secure-keystore/issues",
    "email": "hello@tech-style.co"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://tech-style.co/product-secure-keystore.html",
  "funding": "https://tech-style.co/",
  "keywords": [
    "encryption",
    "secrets",
    "secret-management",
    "keystore",
    "key-store",
    "credentials",
    "vault",
    "aes-256-gcm",
    "pbkdf2",
    "authenticated-encryption",
    "encrypt",
    "decrypt",
    "dotenv",
    "env",
    "environment-variables",
    "configuration",
    "config",
    "api-keys",
