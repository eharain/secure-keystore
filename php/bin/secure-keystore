#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * The command line for the secure-keystore format.
 *
 * Every line this package prints is printed here. The library takes a logger and
 * is otherwise silent, which is what lets it drop into an application that has
 * opinions about its own logging.
 *
 * The verbs, the error codes and the --json output match every other
 * implementation, so a shell script should not be able to tell which one it is
 * calling.
 */

namespace TechStyle\SecureKeystore\Cli;

use TechStyle\SecureKeystore\ErrorCodes;
use TechStyle\SecureKeystore\Format;
use TechStyle\SecureKeystore\Keystore;
use TechStyle\SecureKeystore\KeystoreException;
use TechStyle\SecureKeystore\ValueToken;

// Works both from a Composer install and from a clone of the repository.
$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$loaded = false;
foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        $loaded = true;
        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "Could not find the Composer autoloader. Run: composer install\n");
    exit(1);
}

const NAME = 'secure-keystore';
const VERSION = '3.0.0';

/**
 * Pull the flags out and leave the positional arguments behind.
 *
 * Written by hand rather than with getopt(), because flags may appear after the
 * verb here and getopt() stops at the first non-option argument.
 *
 * @param list<string> $argv
 * @return array{0: array<string, mixed>, 1: list<string>}
 */
function parseArgs(array $argv): array
{
    $flags = [
        'keystore' => null,
        'iterations' => null,
        'json' => false,
        'quiet' => false,
        'help' => false,
        'version' => false,
    ];
    $positional = [];

    for ($index = 0; $index < count($argv); $index++) {
        $arg = $argv[$index];

        if ($arg === '--keystore' && $index + 1 < count($argv)) {
            $flags['keystore'] = $argv[++$index];
        } elseif (str_starts_with($arg, '--keystore=')) {
            $flags['keystore'] = substr($arg, strlen('--keystore='));
        } elseif ($arg === '--iterations' && $index + 1 < count($argv)) {
            $flags['iterations'] = (int) $argv[++$index];
        } elseif (str_starts_with($arg, '--iterations=')) {
            $flags['iterations'] = (int) substr($arg, strlen('--iterations='));
        } elseif ($arg === '--json') {
            $flags['json'] = true;
        } elseif ($arg === '--quiet') {
            $flags['quiet'] = true;
        } elseif ($arg === '--help' || $arg === '-h') {
            $flags['help'] = true;
        } elseif ($arg === '--version' || $arg === '-v') {
            $flags['version'] = true;
        } else {
            $positional[] = $arg;
        }
    }

    return [$flags, $positional];
}

function showHelp(): void
{
    $name = NAME;
    $version = VERSION;
    $default = Format::DEFAULT_ITERATIONS;

    echo <<<HELP

    {$name} {$version} - encrypted secrets at rest, with no service to run

    Usage:
      {$name} secure <input-file> <user-key> [store-name]
      {$name} get <key> <user-key> [store-name]
      {$name} all <store-name> <user-key>
      {$name} set <key> <value> <user-key> <store-name>
      {$name} migrate <store-name> <user-key>
      {$name} list <store-name>
      {$name} stores
      {$name} info <store-name>
      {$name} delete <key> <store-name>
      {$name} delete-store <store-name>
      {$name} export <store-name> [backup-path]
      {$name} import <backup-path> [store-name]
      {$name} encrypt <value> <user-key>
      {$name} decrypt <token> <user-key>
      {$name} --help | --version

    Options:
      --keystore <dir>     where stores live (default ./.keystore)
      --iterations <n>     PBKDF2 rounds for new or migrated stores (default {$default})
      --json               print machine-readable JSON instead of prose
      --quiet              print results only, no progress

    Examples:
      {$name} secure keys.env "\$USER_KEY" production
      {$name} get api_key "\$USER_KEY" production
      {$name} stores
      {$name} migrate production "\$USER_KEY"

    A key name is not a secret: 'list', 'stores' and 'info' read metadata and need
    no user key. 'get', 'all', 'set' and 'migrate' decrypt, and do.

    HELP;
    echo "\n";
}

[$flags, $positional] = parseArgs(array_slice($argv, 1));

if ($flags['version']) {
    echo VERSION . "\n";
    exit(0);
}

if ($flags['help'] || $positional === []) {
    showHelp();
    exit(0);
}

$jsonFlags = JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;

/**
 * Each command hands over both forms of its result at once: text for a person,
 * data for a script. Which one is printed is decided in one place.
 *
 * @param array<string, mixed> $data
 */
$emit = static function (string $text, array $data) use ($flags, $jsonFlags): int {
    echo($flags['json'] ? (string) json_encode($data, $jsonFlags) : $text) . "\n";

    return 0;
};

$usage = static function (string $line): int {
    fwrite(STDERR, 'Usage: ' . NAME . " {$line}\n");

    return 1;
};

try {
    $store = new Keystore(
        $flags['keystore'] !== null ? (realpath($flags['keystore']) ?: $flags['keystore']) : null,
        $flags['iterations'] ?: Format::DEFAULT_ITERATIONS,
        ($flags['quiet'] || $flags['json']) ? null : static fn (string $line) => print($line . "\n")
    );

    $command = $positional[0];
    $args = array_slice($positional, 1);

    switch ($command) {
        case 'secure':
            if (count($args) < 2) {
                exit($usage('secure <input-file> <user-key> [store-name]'));
            }
            $result = $store->secure($args[0], $args[1], $args[2] ?? null);
            exit($emit(implode("\n", $result['keys']), $result));

        case 'get':
            if (count($args) < 2) {
                exit($usage('get <key> <user-key> [store-name]'));
            }
            $value = $store->get($args[0], $args[1], $args[2] ?? null);
            // The bare value, so KEY=$(secure-keystore get x "$K" prod) works.
            exit($emit($value, ['key' => $args[0], 'value' => $value]));

        case 'all':
            if (count($args) < 2) {
                exit($usage('all <store-name> <user-key>'));
            }
            $values = $store->getAll($args[1], $args[0]);
            ksort($values);
            $lines = [];
            foreach ($values as $key => $value) {
                $lines[] = "{$key}={$value}";
            }
            exit($emit(implode("\n", $lines), ['store' => $args[0], 'values' => $values]));

        case 'set':
            if (count($args) < 4) {
                exit($usage('set <key> <value> <user-key> <store-name>'));
            }
            $result = $store->set($args[0], $args[1], $args[2], $args[3]);
            $verb = $result['added'] ? 'added to' : 'updated in';
            exit($emit("Key \"{$result['key']}\" {$verb} \"{$result['storeName']}\"", $result));

        case 'migrate':
            if (count($args) < 2) {
                exit($usage('migrate <store-name> <user-key>'));
            }
            $result = $store->migrate($args[0], $args[1]);
            $text = $result['from'] === $result['to']
                ? "Store \"{$result['storeName']}\" re-encrypted in format {$result['to']} "
                    . "at {$result['iterations']} iterations"
                : "Store \"{$result['storeName']}\" migrated from format {$result['from']} to {$result['to']}";
            exit($emit($text, $result));

        case 'list':
            if (count($args) < 1) {
                exit($usage('list <store-name>'));
            }
            $keys = $store->listKeys($args[0]);
            exit($emit(implode("\n", $keys), ['store' => $args[0], 'keys' => $keys]));

        case 'stores':
            $infos = array_map(
                static fn (string $name) => $store->getStoreInfo($name),
                $store->listStores()
            );
            $lines = array_map(
                static fn (array $info) => "{$info['name']}  ({$info['totalKeys']} keys)",
                $infos
            );
            exit($emit($lines === [] ? 'No stores found' : implode("\n", $lines), ['stores' => $infos]));

        case 'info':
            if (count($args) < 1) {
                exit($usage('info <store-name>'));
            }
            $info = $store->getStoreInfo($args[0]);
            $shown = $info['current']
                ? $info['version']
                : $info['version'] . '  (run migrate to bring it to ' . Format::STORE_VERSION . ')';
            $text = implode("\n", [
                "Name:        {$info['name']}",
                "Path:        {$info['path']}",
                "Format:      {$shown}",
                "Created:     {$info['created']}",
                "Updated:     {$info['updated']}",
                "Iterations:  {$info['iterations']}",
                "Total keys:  {$info['totalKeys']}",
                'Keys:        ' . implode(', ', $info['keys']),
                "Source file: {$info['sourceFile']}",
            ]);
            exit($emit($text, $info));

        case 'delete':
            if (count($args) < 2) {
                exit($usage('delete <key> <store-name>'));
            }
            $store->deleteKey($args[0], $args[1]);
            exit($emit(
                "Key \"{$args[0]}\" deleted from \"{$args[1]}\"",
                ['key' => $args[0], 'store' => $args[1], 'deleted' => true]
            ));

        case 'delete-store':
            if (count($args) < 1) {
                exit($usage('delete-store <store-name>'));
            }
            $store->deleteStore($args[0]);
            exit($emit("Keystore \"{$args[0]}\" deleted", ['store' => $args[0], 'deleted' => true]));

        case 'export':
            if (count($args) < 1) {
                exit($usage('export <store-name> [backup-path]'));
            }
            $written = $store->exportStore($args[0], $args[1] ?? null);
            exit($emit($written, ['store' => $args[0], 'path' => $written]));

        case 'import':
            if (count($args) < 1) {
                exit($usage('import <backup-path> [store-name]'));
            }
            $imported = $store->importStore($args[0], $args[1] ?? null);
            exit($emit("Store imported as \"{$imported}\"", ['store' => $imported]));

        case 'encrypt':
            if (count($args) < 2) {
                exit($usage('encrypt <value> <user-key>'));
            }
            $token = ValueToken::encrypt($args[0], $args[1], $flags['iterations']);
            exit($emit((string) $token, ['token' => $token]));

        case 'decrypt':
            if (count($args) < 2) {
                exit($usage('decrypt <token> <user-key>'));
            }
            $value = ValueToken::decrypt($args[0], $args[1]);
            exit($emit((string) $value, ['value' => $value]));

        default:
            fwrite(STDERR, "Unknown command: {$command}\n\n");
            showHelp();
            exit(1);
    }
} catch (KeystoreException $error) {
    // The code first, because the code is the half that is stable, and the same
    // line every implementation prints for the same failure.
    if ($flags['json']) {
        fwrite(STDERR, (string) json_encode(
            ['error' => $error->getMessage(), 'code' => $error->getErrorCode()],
            $jsonFlags
        ) . "\n");
    } else {
        fwrite(STDERR, $error->getErrorCode() . ': ' . $error->getMessage() . "\n");
    }
    exit(1);
}
