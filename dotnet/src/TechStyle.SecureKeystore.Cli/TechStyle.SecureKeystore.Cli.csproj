<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>secure-keystore</AssemblyName>
    <RootNamespace>TechStyle.SecureKeystore.Cli</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>secure-keystore</ToolCommandName>
    <PackageId>TechStyle.SecureKeystore.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ejaz Hussain Arain</Authors>
    <Company>Tech Style Ltd</Company>
    <Description>Command line for secure-keystore: encrypted secrets at rest, with no service to run.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/eharain/secure-keystore</PackageProjectUrl>
    <PackageTags>encryption;secrets;keystore;cli;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TechStyle.SecureKeystore/TechStyle.SecureKeystore.csproj" />
  </ItemGroup>

</Project>
